%% Voting Aid: from an opinion to the ranking. The same flow as workflow.html,
%% as text: open it in mermaid.live, or import it into Excalidraw, draw.io or Miro.
%% Circles are events, boxes tasks, diamonds decisions, cylinders data. Counts
%% and what a step runs once for are on the HTML page.
flowchart TB
  start((Du schreibst zu jedem Thema,<br/>was passieren soll)):::person
  query[Meinung einbetten]:::voyage
  split{+}
  start --> query --> split

  subgraph Programme
    pdb[(Wahlprogramme 2025<br/>2.025 Abschnitte)]:::data
    psearch[Nächste Abschnitte suchen<br/>4 je Partei]:::code
    prel[Sagt der Abschnitt etwas<br/>zur Forderung?]:::jev
    pgate{passt, ab 0,5?}
    pmatch[Wo steht die Partei<br/>zur Forderung?]:::jev
    psource[Zitat auswählen:<br/>welcher Abschnitt zeigt die Position am klarsten?]:::jev
    pdb -.-> psearch --> prel --> pgate -->|ja| pmatch --> psource
  end

  subgraph Abstimmungen
    vdb[(Namentliche Abstimmungen<br/>654, namentlich und per Handzeichen)]:::data
    vsearch[Nächste Abstimmungen suchen<br/>12 insgesamt]:::code
    vrel[Geht es in der Abstimmung<br/>um die Forderung?]:::jev
    vgate{passt, ab 0,5?}
    vdir[Wohin führt ein Ja:<br/>zur Forderung hin oder weg?]:::jev
    vcompare[Mit den Fraktionen vergleichen<br/>Ablehnungsempfehlungen umgedreht]:::code
    vdb -.-> vsearch --> vrel --> vgate -->|ja| vdir --> vcompare
  end

  subgraph Aussagen
    sdb[(Reden im Bundestag und Websites<br/>der Fraktionen und Bundesparteien)]:::data
    ssearch[Nächste Aussagen suchen<br/>3 je Partei]:::code
    srel[Sagt die Aussage etwas<br/>zur Forderung?]:::jev
    sgate{passt, ab 0,5?}
    smatch[Wo steht die Partei<br/>zur Forderung?]:::jev
    ssource[Zitat auswählen:<br/>welche Aussage zeigt die Position am klarsten?]:::jev
    sdb -.-> ssearch --> srel --> sgate -->|ja| smatch --> ssource
  end

  split --> psearch & vsearch & ssearch
  join{+}
  psource & vcompare & ssource --> join
  pgate -->|nein| pdrop(((fällt weg)))
  vgate -->|nein| vdrop(((fällt weg)))
  sgate -->|nein| sdrop(((fällt weg)))
  combine[Werte zusammenführen<br/>je Thema und Quelle, über Themen, nach Gewichtung]:::code
  done(((Rangliste mit Belegen))):::person
  join --> combine --> done

  classDef person fill:#fbf1d9,stroke:#e8b54a
  classDef voyage fill:#e6effc,stroke:#4f8fe0
  classDef jev fill:#efe7fb,stroke:#8a63d2,stroke-width:2px
  classDef code fill:#eceef1,stroke:#8a8f98
  classDef data fill:#f4efe4,stroke:#b9ae97
